# Dialyn (managed by deploy/setup_vps.sh). Only this file belongs to Dialyn.
map $http_upgrade $dialyn_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Recorded greetings are uploaded through the dashboard (max 5 MB).
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        # WebSockets: telephony media streams.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dialyn_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Calls can last several minutes.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
