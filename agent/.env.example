# ---- Server ----
# Public HTTPS host that Twilio can reach (e.g. your ngrok domain), no scheme.
PUBLIC_HOST=your-subdomain.ngrok-free.app
PORT=7860
# Platform admin key: creates merchants (X-Admin-Key) and protects /api/* (X-API-Key). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Signs short-lived media-stream tokens.
STREAM_SIGNING_SECRET=change-me-too
# sqlite for dev, postgres for prod: postgresql+asyncpg://user:pass@host:5432/calls
DATABASE_URL=sqlite+aiosqlite:///./data/calls.db
DEFAULT_AGENT_ID=default
# Set false only for local testing without a public host.
VALIDATE_TWILIO_SIGNATURE=true
RECORDINGS_DIR=./data/recordings
# Background dialer for merchant calls (calling hours, retries).
SCHEDULER_ENABLED=true

# ---- Telephony: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+10000000000

# Free stack for English: DEEPGRAM_API_KEY + GROQ_API_KEY. Hinglish calls also need SARVAM_API_KEY.
# ---- STT ----
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ---- LLM ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ---- TTS ----
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
